{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@cat-food-distributor/shared/auth/data-access": [
        "libs/shared/auth/data-access/src/index.ts"
      ],
      "@cat-food-distributor/shared/data-access/api": [
        "libs/shared/data-access/api/src/index.ts"
      ],
      "@cat-food-distributor/shared/data-access/store": [
        "libs/shared/data-access/store/src/index.ts"
      ],
      "@cat-food-distributor/shared/data-access/store-types": [
        "libs/shared/data-access/store-types/src/index.ts"
      ],
      "@cat-food-distributor/shared/distributors/data-access": [
        "libs/shared/distributors/data-access/src/index.ts"
      ],
      "@cat-food-distributor/shared/food-schedules/data-access": [
        "libs/shared/food-schedules/data-access/src/index.ts"
      ],
      "@cat-food-distributor/shared/food-servings/data-access": [
        "libs/shared/food-servings/data-access/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
